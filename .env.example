# Vercel AI Gateway (legacy fallback for any provider without a direct path).
AI_GATEWAY_API_KEY=

# Direct provider keys (bypass the gateway). Judge/user models are routed to
# these by provider prefix: openai/* -> OPENAI_API_KEY, deepseek/* ->
# DEEPSEEK_API_KEY, anthropic/* -> ANTHROPIC_API_KEY.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# MyDD chat endpoint (the custom-* target model).
MYDD_ENDPOINT_URL=
